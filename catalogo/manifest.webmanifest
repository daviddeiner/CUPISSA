{
  "id": "/catalogo/",
  "name": "CUPISSA | Catálogo y compras",
  "short_name": "CUPISSA",
  "description": "Descubre, personaliza, compra y alquila productos CUPISSA.",
  "lang": "es-CO",
  "start_url": "/catalogo/?source=app",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    {
      "src": "assets/images/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
